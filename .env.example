SEDUX_ENV=development
SEDUX_LOG_LEVEL=INFO
SEDUX_HOST=0.0.0.0
SEDUX_PORT=8080
SEDUX_DEBUG=false
DATABASE_URL=postgresql://sedux:sedux@postgres:5432/sedux
REDIS_URL=redis://redis:6379/0
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SEDUX_AUTH_SECRET=replace-with-at-least-32-random-characters
